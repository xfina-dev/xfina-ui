{
  "name": "xfina-ui",
  "version": "0.7.1",
  "description": "The theme and UI components of the xfina.dev sites: a Tailwind preset, light/dark, the shared header and shadcn-vue components.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-assets.mjs",
    "test": "vitest run",
    "demo": "node scripts/build-assets.mjs && vite --config demo/vite.config.js",
    "demo:build": "node scripts/build-assets.mjs && vite build --config demo/vite.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfina-dev/xfina-ui.git"
  },
  "homepage": "https://github.com/xfina-dev/xfina-ui#readme",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./style.css": "./dist/style.css",
    "./tailwind": "./dist/tailwind.js",
    "./vite": "./dist/vite.js",
    "./logo.svg": "./dist/logo.svg",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "tailwindcss": "^3.4.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vueuse/core": "^10.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "echarts": "^6.1.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  }
}
